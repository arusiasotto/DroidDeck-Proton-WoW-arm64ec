diff --git a/dlls/ntdll/unix/syscall.c b/dlls/ntdll/unix/syscall.c
index 413f5f8..e530843 100644
--- a/dlls/ntdll/unix/syscall.c
+++ b/dlls/ntdll/unix/syscall.c
@@ -246,6 +246,15 @@ static BYTE syscall_args[ARRAY_SIZE(syscalls)] =
 
 #ifdef __aarch64__
 extern void __wine_syscall_dispatcher(void);
+
+void ntdll_arm64ec_sync_syscall_dispatch( TEB *teb )
+{
+    struct ntdll_thread_data *thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+
+    __wine_syscall_dispatcher_slot = (ULONG_PTR)__wine_syscall_dispatcher;
+    KeServiceDescriptorTable[0].CounterTable = (ULONG_PTR *)__wine_syscall_dispatcher;
+    thread_data->syscall_table = KeServiceDescriptorTable;
+}
 #endif
 
 SYSTEM_SERVICE_TABLE KeServiceDescriptorTable[4] =
 {
