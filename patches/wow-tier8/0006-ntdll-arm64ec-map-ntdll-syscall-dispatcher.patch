+static BOOL is_ntdll_image_name( const UNICODE_STRING *name )
+{
+    static const WCHAR ntdllW[] = {'n','t','d','l','l','.','d','l','l'};
+    const WCHAR *p = name->Buffer;
+    unsigned int len = name->Length / sizeof(WCHAR);
+    unsigned int i;
+
+    if (len < ARRAY_SIZE( ntdllW )) return FALSE;
+    p += len - ARRAY_SIZE( ntdllW );
+    for (i = 0; i < ARRAY_SIZE( ntdllW ); i++)
+        if (RtlUpcaseUnicodeChar( p[i] ) != ntdllW[i]) return FALSE;
+    return TRUE;
+}
+
+static ULONG_PTR map_image_find_ordinal_export( HMODULE module, const IMAGE_EXPORT_DIRECTORY *exports,
+                                                DWORD ordinal )
+{
+    const DWORD *functions = (const DWORD *)((BYTE *)module + exports->AddressOfFunctions);
+
+    if (ordinal >= exports->NumberOfFunctions) return 0;
+    if (!functions[ordinal]) return 0;
+    return (ULONG_PTR)module + functions[ordinal];
+}
+
+static ULONG_PTR map_image_find_named_export( HMODULE module, const IMAGE_EXPORT_DIRECTORY *exports,
+                                              const char *name )
+{
+    const WORD *ordinals = (const WORD *)((BYTE *)module + exports->AddressOfNameOrdinals);
+    const DWORD *names = (const DWORD *)((BYTE *)module + exports->AddressOfNames);
+    int min = 0, max = exports->NumberOfNames - 1;
+
+    while (min <= max)
+    {
+        int res, pos = (min + max) / 2;
+        char *ename = (char *)module + names[pos];
+        if (!(res = strcmp( ename, name ))) return map_image_find_ordinal_export( module, exports, ordinals[pos] );
+        if (res > 0) max = pos - 1;
+        else min = pos + 1;
+    }
+    return 0;
+}
+
+static INT64 map_image_ldr_literal_offset( UINT32 insn )
+{
+    INT64 imm19 = (insn >> 5) & 0x7ffff;
+
+    if (imm19 & 0x40000) imm19 |= ~0x7ffffLL;
+    return imm19 << 2;
+}
+
+static void map_image_pwrite_qword( struct file_view *view, void *addr, ULONG_PTR value )
+{
+    BYTE *page = ROUND_ADDR( (BYTE *)addr, page_mask );
+    BYTE vprot = get_page_vprot( page );
+    BOOL readonly = !(vprot & VPROT_WRITE);
+
+    if (readonly)
+    {
+        BYTE write_vprot = (vprot & ~(VPROT_WRITECOPY | VPROT_WRITEWATCH)) | VPROT_WRITE | VPROT_COMMITTED;
+        set_page_vprot( page, host_page_size, write_vprot );
+        mprotect_range( page, host_page_size, 0, 0 );
+    }
+
+    *(ULONG_PTR *)addr = value;
+
+    if (readonly)
+    {
+        set_page_vprot( page, host_page_size, vprot );
+        mprotect_range( page, host_page_size, 0, 0 );
+    }
+}
+
+static void map_image_patch_wine_syscall_stub_slots( struct file_view *view, char *base,
+                                                     IMAGE_NT_HEADERS *nt, SIZE_T total_size,
+                                                     ULONG_PTR dispatcher )
+{
+    static const UINT32 mov_x9_x30 = 0xaa1e03e9;
+    IMAGE_SECTION_HEADER *sec = IMAGE_FIRST_SECTION( nt );
+    unsigned int i, j;
+
+    for (i = 0; i < nt->FileHeader.NumberOfSections; i++)
+    {
+        SIZE_T sec_size;
+        UINT32 *code, *end;
+
+        if (!(sec[i].Characteristics & IMAGE_SCN_MEM_EXECUTE)) continue;
+        if (!sec[i].Misc.VirtualSize) continue;
+        if (sec[i].VirtualAddress >= total_size) continue;
+
+        sec_size = sec[i].Misc.VirtualSize;
+        if (sec[i].VirtualAddress + sec_size > total_size)
+            sec_size = total_size - sec[i].VirtualAddress;
+
+        code = (UINT32 *)(base + sec[i].VirtualAddress);
+        end = (UINT32 *)((char *)code + sec_size);
+
+        for (j = 0; code + j + 4 < end; j++)
+        {
+            UINT32 *insn = code + j;
+            ULONG_PTR literal, cell;
+
+            if (insn[1] != mov_x9_x30) continue;
+            if ((insn[0] & 0xff000000) != 0xd2000000) continue; /* mov x8, #imm */
+            if ((insn[2] & 0xff000000) != 0x58000000) continue; /* ldr x16, label */
+            if (insn[3] != 0xf9400210) continue; /* ldr x16, [x16] */
+
+            literal = (ULONG_PTR)(insn + 2) + map_image_ldr_literal_offset( insn[2] );
+            if (literal + sizeof(ULONG_PTR) > (ULONG_PTR)base + total_size) continue;
+
+            cell = *(ULONG_PTR *)literal;
+            if (!cell) continue;
+            if (*(ULONG_PTR *)cell == dispatcher) continue;
+
+            map_image_pwrite_qword( view, (void *)cell, dispatcher );
+            TRACE_(module)( "patched ntdll dispatcher cell %p in mapped view %p\n", (void *)cell, base );
+        }
+    }
+}
+
+static void map_image_init_ntdll_dispatchers( struct file_view *view, const UNICODE_STRING *nt_name,
+                                               char *base, IMAGE_NT_HEADERS *nt, SIZE_T total_size )
+{
+    const IMAGE_EXPORT_DIRECTORY *exports;
+    IMAGE_DATA_DIRECTORY *dir;
+    void **slot;
+    ULONG_PTR export_addr, dispatcher = (ULONG_PTR)__wine_syscall_dispatcher;
+
+    if (!is_ntdll_image_name( nt_name )) return;
+    if (!dispatcher) return;
+
+    dir = get_data_dir( nt, total_size, IMAGE_DIRECTORY_ENTRY_EXPORT );
+    if (!dir) return;
+    exports = (const IMAGE_EXPORT_DIRECTORY *)(base + dir->VirtualAddress);
+
+    export_addr = map_image_find_named_export( base, exports, "__wine_syscall_dispatcher" );
+    if (!export_addr) return;
+
+    slot = (void **)export_addr;
+    if ((ULONG_PTR)*slot != dispatcher)
+    {
+        map_image_pwrite_qword( view, slot, dispatcher );
+        TRACE_(module)( "initialized %s __wine_syscall_dispatcher at %p -> %p\n",
+                        debugstr_us(nt_name), slot, (void *)dispatcher );
+    }
+
+    export_addr = map_image_find_named_export( base, exports, "__wine_unix_call_dispatcher" );
+    if (export_addr)
+    {
+        slot = (void **)export_addr;
+        if (is_arm64ec())
+        {
+            ULONG_PTR ec = map_image_find_named_export( base, exports, "__wine_unix_call_dispatcher_arm64ec" );
+            void **pec = ec ? (void **)ec : NULL;
+
+            if (pec && (ULONG_PTR)*pec != (ULONG_PTR)__wine_unix_call_dispatcher)
+            {
+                ULONG_PTR ec_thunk = (ULONG_PTR)*pec;
+
+                map_image_pwrite_qword( view, slot, ec_thunk );
+                map_image_pwrite_qword( view, pec, (ULONG_PTR)__wine_unix_call_dispatcher );
+            }
+            else if ((ULONG_PTR)*slot != (ULONG_PTR)__wine_unix_call_dispatcher)
+                map_image_pwrite_qword( view, slot, (ULONG_PTR)__wine_unix_call_dispatcher );
+        }
+        else if ((ULONG_PTR)*slot != (ULONG_PTR)__wine_unix_call_dispatcher)
+            map_image_pwrite_qword( view, slot, (ULONG_PTR)__wine_unix_call_dispatcher );
+    }
+
+    map_image_patch_wine_syscall_stub_slots( view, base, nt, total_size, dispatcher );
+}
